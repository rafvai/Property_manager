# Ambiente — MAI committare il .env attivo
.env

# Template committabili (contengono solo valori di esempio)
# .env.development  ← OK committare
# .env.production   ← OK committare

# Chiavi segrete
.secret_key
.encryption_key

# Database
*.db
*.db-shm
*.db-wal

# Eccezione: translations.db è un asset dell'app, non un DB utente
!shared/translations.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Build PyInstaller
build/
dist/

# Log
logs/
*.log

# Export e documenti utente
exports/
docs/

# Preferenze locali
preferences.json

# IDE
.idea/

# Note personali
Sviluppi_futuri.txt

# Env mal nominato (rinominalo in .env.production prima di committarlo)
env.production.env